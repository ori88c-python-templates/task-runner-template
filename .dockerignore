# Git and VCS
.git
.gitignore

# Secrets and local env (never bake .env into the image)
.env
.env.*
!.env.example

# Local tooling
.venv
.cursor
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
.pre-commit-config.yaml
.python-version
.idea
.vscode

# Tests and docs that are not the package README (needed by the build backend)
tests
*.md
!README.md

# Bytecode and OS
**/__pycache__
*.py[cod]
.DS_Store
Thumbs.db
