# Copy to .env for local runs. The app reads this file.
# .env is git-ignored; this file is not.
#
# These values are a working local configuration, not placeholders to invent.
#
# Variable names follow the nested config path, joined by "__":
# LOGGER__MIN_LOG_LEVEL maps to AppConfig.logger.MIN_LOG_LEVEL.

# Deployment environment: local | dev | staging | prod
ENV=local

# --- Logger -----------------------------------------------------------------
# Minimum severity to emit: debug | info | warning | error | critical
# Note: "debug" is rejected when ENV=prod.
LOGGER__MIN_LOG_LEVEL=debug

# --- GitHub report ----------------------------------------------------------
# The organization whose most-starred public repositories the run presents.
# Must be an organization URL on github.com (not a repository URL).
GITHUB_REPORT__ORG_URL=https://github.com/microsoft
# How many repositories to present. 1 to 100 (one Search API page).
GITHUB_REPORT__REPOS_LIMIT=4
# Optional personal access token. Unauthenticated search allows 10 requests a
# minute, authenticated 30. Never logged. Leave unset for the demo.
# GITHUB_REPORT__TOKEN=
# Timeout for every GitHub request, in seconds. Default 10 if unset.
# GITHUB_REPORT__REQUEST_TIMEOUT_SECONDS=10
# Directory for the CSV. The file name YYYY_MM_DD_popular_github_repos.csv is
# added in code, using the UTC date. The directory does not have to exist yet.
GITHUB_REPORT__OUTPUT_DIR_PATH=github_reports
